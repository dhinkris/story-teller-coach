<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>NSMicrophoneUsageDescription</key>
	<string>This app needs microphone access to record your storytelling practice.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>This app needs speech recognition to transcribe your recordings.</string>
	<key>NSCameraUsageDescription</key>
	<string>This app needs camera access to generate images for prompts.</string>
	<!-- Classic opaque bars (Balance-style solid white tab bar) instead of iOS 26 liquid glass -->
	<key>UIDesignRequiresCompatibility</key>
	<true/>
	<key>NSAppTransportSecurity</key>
	<dict>
		<!-- Allow HTTP to localhost for Ollama (llama3.1:8b at port 11434) -->
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
</dict>
</plist>
